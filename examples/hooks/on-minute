#!/bin/sh
# night mode by the clock: copy to ~/.config/finedesktop/hooks/on-minute and chmod +x
# Modes may change the look (nightmode sets theme = zen); this is optional, the default modes only change behaviour.
case "$FD_TIME" in
  22:00) finedesktop ctl mode nightmode ;;
  07:00) finedesktop ctl mode daymode ;;
esac
