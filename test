#!/usr/bin/env bash
# End-to-end test: nested compositor + real foot clients, driven through the control socket.
# Needs a running host Wayland session. Usage: ./test   (runs `cargo test` first)
set -u
cd "$(dirname "$0")"
cargo test -q 2>&1 | tail -3 || exit 1
cargo build -q 2>&1 | grep -E '^error' && exit 1
cargo build -q --release -p finedesktop-engine 2>&1 | grep -E '^error' && exit 1

bin=$PWD/target/debug/finedesktop
log=$(mktemp -d)
fail=0
ok()  { echo "ok   $1"; }
bad() { echo "FAIL $1"; fail=1; }

# own config dir: never the user's autostart, and the real pointer must not move focus
mkdir -p "$log/cfg"; cp target/release/libfinedesktop_engine.so "$log/engine.so"
printf 'focus_follows_mouse = off\nengine = %s\n' "$log/engine.so" > "$log/cfg/config"
mkdir -p "$log/cfg/welcome"
printf '# Tips\n\nSee [the shell](shell.md) or [site](https://example.org) or [nowhere](missing.md).\n- one\n' > "$log/cfg/welcome/tips.md"
printf '# Shell\n\nBack to [tips](tips.md).\n' > "$log/cfg/welcome/shell.md"
touch "$log/start"; sleep 0.05
printf '#!/bin/sh\necho "$*" >> "%s/invoke.log"\n' "$log" > "$log/invoke"; chmod +x "$log/invoke"
FD_NOTTS_INVOKE="$log/invoke" FD_BACKEND=winit FD_CONFIG_DIR="$log/cfg" XDG_STATE_HOME="$log/state" "$bin" >"$log/c.log" 2>&1 &
cpid=$!
trap 'kill $cpid 2>/dev/null; wait $cpid 2>/dev/null' EXIT

for _ in $(seq 50); do
  sock=$(find "${XDG_RUNTIME_DIR:-/tmp}" -maxdepth 1 -name 'finedesktop-*.sock' -newer "$log/start" 2>/dev/null | head -1)
  [ -n "${sock:-}" ] && [ -S "$sock" ] && break
  sleep 0.1
done
export FD_SOCK=$sock
ctl() { "$bin" ctl "$@"; }
wait_clients() { # want_count
  for _ in $(seq 60); do
    n=$(ctl state | grep -c '^  ws')
    [ "$n" = "$1" ] && return 0
    sleep 0.1
  done
  return 1
}
geo() { ctl state | grep "^  ws$1 #$2" | grep -o '[0-9]*x[0-9]*@[0-9-]*,[0-9-]*\|hidden'; }

# --- themes, modes, events ---
[ "$(ctl theme list | grep -c 'matrix\*')" = 1 ] && ok "theme list marks the active one" || bad "theme list"
[ "$(ctl theme dracula)" = ok ] && ctl theme list | grep -q 'dracula\*' && ok "theme switch" || bad "theme switch"
[ "$(ctl theme nope | cut -c1-6)" = error: ] && ok "unknown theme rejected" || bad "unknown theme accepted"
[ "$(ctl mode gamemode)" = ok ] && ok "mode on" || bad "mode on"
ctl theme list | grep -q 'dracula\*' && ok "mode leaves the theme alone" || bad "mode changed the theme"
[ "$(ctl mode off)" = ok ] && ok "mode off" || bad "mode off"
[ "$(ctl mode nightmode)" = ok ] && ctl theme list | grep -q 'zen\*' && ok "nightmode switches theme" || bad "nightmode"
ctl mode off >/dev/null; ctl theme list | grep -q 'dracula\*' && ok "mode off restores theme" || bad "theme not restored"
ctl theme matrix >/dev/null
[ "$(ctl welcome show)" = ok ] && [ "$(ctl welcome hide)" = ok ] && [ "$(ctl welcome auto)" = ok ] && ok "welcome show/hide/auto" || bad "panel actions"
ctl welcome home | grep -q ok; ctl welcome list | grep -q 'Tips' && ok "welcome home lists the pages" || bad "welcome home"
[ "$(ctl welcome open tips)" = ok ] && ctl welcome list | grep -q '^# Tips' && ok "welcome open page" || bad "welcome open"
ctl welcome list | grep -q '\[1\] the shell -> Shell' && ctl welcome list | grep -q '\[2\] site -> https://example.org' && ok "welcome links numbered, dead link plain" || bad "welcome links"
ctl welcome list | grep -q 'nowhere ->' && bad "dead link listed" || ok "dead link not a link"
[ "$(ctl welcome link 1)" = ok ] && ctl welcome list | grep -q '^# Shell' && ok "welcome link opens page" || bad "welcome link"
[ "$(ctl welcome back)" = ok ] && ctl welcome list | grep -q '^# Tips' && ok "welcome back" || bad "welcome back"
[ "$(ctl welcome forward)" = ok ] && ctl welcome list | grep -q '^# Shell' && ok "welcome forward" || bad "welcome forward"
[ "$(ctl welcome next)" = ok ] && [ "$(ctl welcome follow)" = ok ] && ctl welcome list | grep -q '^# Tips' && ok "welcome next+follow" || bad "welcome follow"
[ "$(ctl welcome open nope | cut -c1-6)" = error: ] && ok "welcome unknown page rejected" || bad "welcome unknown page"
ctl welcome home >/dev/null
[ "$(ctl welcome bogus | cut -c1-6)" = error: ] && ok "bad welcome action rejected" || bad "bad welcome action accepted"
( ctl subscribe > "$log/sub.out" 2>&1 & echo $! > "$log/sub.pid" ); sleep 0.3
ctl emit ping hello >/dev/null; ctl bar toggle >/dev/null; ctl bar toggle >/dev/null; sleep 0.3
kill "$(cat "$log/sub.pid")" 2>/dev/null
grep -q '^user ping hello' "$log/sub.out" && ok "subscribe streams user events" || bad "subscribe: $(cat "$log/sub.out")"

ctl state json | python3 -c 'import json,sys; d=json.load(sys.stdin); m=d["monitors"][0]; assert m["workspaces"]==9 and d["theme"] and isinstance(d["menu"],bool) and isinstance(m["windows"],list)' && ok "state json parses" || bad "state json"
[ "$(ctl state | head -1 | grep -c monitor)" = 1 ] && ok "state reports a monitor" || bad "no monitor"
out=$(ctl state | head -1); W=$(echo "$out" | sed -E 's/.* ([0-9]+)x[0-9]+@.*/\1/')

for i in 1 2 3; do ctl spawn foot -e sleep 60 >/dev/null; sleep 0.4; done
wait_clients 3 && ok "3 clients mapped" || bad "clients did not map"
foc() { ctl state | grep -o '^  ws[0-9]* #[0-9]*\*' | grep -o '#[0-9]*'; }
ctl layout tile >/dev/null; ctl view 1 >/dev/null; sleep 0.3
[ "$(foc)" = "#0" ] || ctl focus left >/dev/null
ctl focus right >/dev/null; sleep 0.2; [ "$(foc)" = "#1" ] && ok "focus right: master -> stack" || bad "focus right: $(foc)"
ctl focus down >/dev/null; sleep 0.2;  [ "$(foc)" = "#2" ] && ok "focus down inside the stack" || bad "focus down: $(foc)"
ctl focus up >/dev/null; sleep 0.2;    [ "$(foc)" = "#1" ] && ok "focus up inside the stack" || bad "focus up: $(foc)"
ctl focus left >/dev/null; sleep 0.2;  [ "$(foc)" = "#0" ] && ok "focus left: back to master" || bad "focus left: $(foc)"
ctl focus up >/dev/null; sleep 0.2;    [ "$(foc)" = "#0" ] && ok "focus up at the edge stays" || bad "focus up edge: $(foc)"
ctl focus right >/dev/null; sleep 0.2; ctl focus last >/dev/null; sleep 0.2; [ "$(foc)" = "#0" ] && ok "focus last returns to the previous window" || bad "focus last: $(foc)"
ctl move right >/dev/null; sleep 0.3;  [ "$(foc)" = "#1" ] && ok "move right swaps with the stack window" || bad "move right: $(foc)"
ctl move left >/dev/null; sleep 0.3;   [ "$(foc)" = "#0" ] && ok "move left swaps back" || bad "move left: $(foc)"

ctl layout tile >/dev/null; sleep 0.3
g0=$(geo 1 0); mw=${g0%%x*}
[ "$mw" = "$((W * 55 / 100))" ] && ok "tile: master is 55% ($mw of $W)" || bad "tile master width $mw of $W"

ctl mfact +0.1 >/dev/null; sleep 0.3
g0=$(geo 1 0); mw=${g0%%x*}
[ "$mw" = "$((W * 65 / 100))" ] && ok "mfact +0.1 -> $mw" || bad "mfact gave $mw"

ctl layout monocle >/dev/null; sleep 0.3
hid=$(ctl state | grep -c 'hidden')
[ "$hid" = 2 ] && ok "monocle hides 2 of 3" || bad "monocle hidden=$hid"

ctl layout grid >/dev/null; sleep 0.3
hid=$(ctl state | grep -c 'hidden')
[ "$hid" = 0 ] && ok "grid shows all" || bad "grid hidden=$hid"

ctl layout float >/dev/null; sleep 0.3
ctl state | grep '^  ws' | grep -q hidden && bad "float hides windows" || ok "float shows all"

ctl layout tile >/dev/null
ctl view 2 >/dev/null; sleep 0.3
ctl state | head -1 | grep -q 'ws 2/9' && ok "view 2" || bad "view 2"
[ "$(ctl state | grep -c hidden)" = 3 ] && ok "ws1 clients hidden on ws2" || bad "ws1 clients visible on ws2"
ctl spawn foot -e sleep 60 >/dev/null; wait_clients 4 && ok "client on ws2" || bad "ws2 client"
ctl view 1 >/dev/null; sleep 0.3
ctl state | grep -q '^  ws2 #0.* hidden' && ok "ws2 client hidden on ws1" || bad "ws2 client not hidden"

ctl tag 3 >/dev/null; sleep 0.3
ctl state | grep -q '^  ws3 #0' && ok "tag 3 moved focused window" || bad "tag 3"

ctl focus next >/dev/null; ctl close >/dev/null
for _ in $(seq 30); do [ "$(ctl state | grep -c '^  ws')" = 3 ] && break; sleep 0.1; done
[ "$(ctl state | grep -c '^  ws')" = 3 ] && ok "close removed a client" || bad "close"

# hot reload of the engines: windows stay where they are, a broken library is refused and the old one keeps working
ctl layout tile >/dev/null; sleep 0.3
before=$(ctl state | grep -c '^  ws')
ctl reload-engine 2>&1 | grep -q 'engine loaded' && ok "reload-engine loads the library" || bad "reload-engine"
[ "$(ctl state | grep -c '^  ws')" = "$before" ] && ok "reload-engine keeps the windows" || bad "reload-engine lost windows"
cp "$log/engine.so" "$log/engine.good"; echo junk > "$log/engine.so"
ctl reload-engine 2>&1 | grep -q '^error' && ok "broken engine library refused" || bad "broken engine accepted"
ctl layout grid 2>&1 | grep -q '^ok' && ok "layouts still work after a refused reload" || bad "layout after refused reload"
ctl layout tile >/dev/null; cp "$log/engine.good" "$log/engine.so"

# the menu, driven like an agent would: open, type, select
ctl menu open settings | grep -q '^ok' && ok "menu opens" || bad "menu open"
ctl menu list | head -1 | grep -q '^Menu > Ustawienia$' && ok "menu shows its breadcrumb" || bad "menu breadcrumb"
ctl menu type Przyspieszenie >/dev/null; ctl menu list | head -1 | grep -q 'Szukaj' && ctl menu list | grep -q 'Przyspieszenie' && ok "typing in settings searches every panel" || bad "settings find"
ctl menu key esc >/dev/null; ctl menu key esc >/dev/null; ctl menu open settings >/dev/null
ctl menu type uklad >/dev/null; ctl menu key enter >/dev/null
ctl menu type mono >/dev/null; ctl menu list | sed -n 2p | grep -q 'monocle' && ok "menu filters" || bad "menu filter"
ctl menu key enter >/dev/null; sleep 0.3
ctl state | head -1 | grep -q 'layout monocle' && ok "menu entry changes the layout" || bad "menu layout entry"
ctl menu list 2>&1 | grep -q 'not open' && ok "menu closes after a choice" || bad "menu stayed open"
ctl layout tile >/dev/null
ctl menu open apps >/dev/null; ctl menu key backspace >/dev/null; ctl menu list | head -1 | grep -q '^Menu$' && ok "backspace leaves a level" || bad "backspace level"
ctl menu key esc >/dev/null; ctl menu list 2>&1 | grep -q 'not open' && ok "esc closes the menu" || bad "esc"
ctl menu open fonts >/dev/null; ctl menu list | head -1 | grep -q '^Menu > Ustawienia > Wyglad > Czcionki$' && ctl menu list | grep -q 'wbudowana' && ok "fonts panel lists the built-in font" || bad "fonts panel"
ctl menu key esc >/dev/null
ctl menu open apps >/dev/null; ctl menu list | grep -q 'Terminal\|Flatpak\|Natywne' && ok "apps list has sections" || bad "apps sections"
ctl menu key esc >/dev/null
ctl menu open create_theme >/dev/null; ctl menu list | grep -q 'Zapisz jako: custom' && ok "theme editor lists colours and save" || bad "theme editor"
ctl menu key down >/dev/null; ctl menu key enter >/dev/null; ctl menu list | head -1 | grep -q 'Utworz motyw > Kolor' && ok "enter on a colour opens the picker" || bad "picker open"
ctl menu type "#102030" >/dev/null; ctl menu list | grep -q 'Ustaw #102030' && ok "typed colour is offered" || bad "typed colour"
ctl menu key esc >/dev/null; ctl menu list 2>&1 | grep -q 'not open' && ok "esc leaves the editor" || bad "editor esc"
ctl menu open theme-import >/dev/null; ctl menu type /nonexistent/x.theme >/dev/null; ctl menu key enter >/dev/null; ctl menu list | grep -q 'Importuj' && ok "import offers the typed path" || bad "import"
ctl menu key esc >/dev/null
ctl menu open create_theme >/dev/null; ctl menu type e2etheme >/dev/null
for _ in $(seq 12); do ctl menu key down >/dev/null; done
ctl menu key enter >/dev/null; sleep 0.3
[ -f "$log/cfg/themes/e2etheme" ] && grep -q '^theme = e2etheme' "$log/cfg/config" && ok "theme editor saves a theme and uses it" || bad "theme save"
cp "$log/cfg/themes/e2etheme" "$log/imp.theme"; sed -i 's/^accent.*/accent = #123456/' "$log/imp.theme"
ctl menu open theme-import >/dev/null; ctl menu type "$log/imp.theme" >/dev/null; ctl menu key down >/dev/null; ctl menu key enter >/dev/null; sleep 0.3
[ -f "$log/cfg/themes/imp" ] && grep -q '^theme = imp' "$log/cfg/config" && ok "theme file imported and used" || bad "theme import"
echo 'nonsense' > "$log/bad.theme"
ctl menu open theme-import >/dev/null; ctl menu type "$log/bad.theme" >/dev/null; ctl menu key down >/dev/null; ctl menu key enter >/dev/null
[ ! -f "$log/cfg/themes/bad" ] && ok "a non-theme file is refused" || bad "bad theme imported"
ctl menu key esc >/dev/null
ctl menu open bar >/dev/null; ctl menu list | grep -q 'u gory' && ok "bar panel" || bad "bar panel"
ctl menu key esc >/dev/null
ctl menu open input >/dev/null; ctl menu list | grep -q 'Szybkosc wskaznika' && ok "keyboard and mouse panel" || bad "input panel"
ctl menu key esc >/dev/null
ctl menu open screens >/dev/null
ctl menu open screens >/dev/null; ctl menu list | head -1 | grep -q 'Ekrany' && ok "screens panel opens" || bad "screens panel"
ctl menu key enter >/dev/null; ctl menu list | head -1 | grep -q 'Wybierz$' && ok "a screen dropdown opens its modes" || bad "screen dropdown"
ctl menu key enter 2>&1 | grep -q 'saved' || true
grep -q '^output = winit' "$log/cfg/config" && ok "screen choice is written to the config" || bad "screen persist"
ctl menu key esc >/dev/null
ctl menu open prefer >/dev/null; ctl menu list | grep -q 'pdf (pdf epub djvu)' && ctl menu list | grep -q 'cad (stl' && ok "prefer lists the file formats" || bad "prefer formats"
ctl menu key up >/dev/null; ctl menu list | grep '^> ' | grep -q 'mail' && ok "Up on the first row wraps to the last" || bad "wrap up"
ctl menu key down >/dev/null; ctl menu list | grep '^> ' | grep -q 'terminal' && ok "Down on the last row wraps to the first" || bad "wrap down"
ctl menu key esc >/dev/null
ctl menu open audio >/dev/null; ctl menu list | head -1 | grep -q 'Dzwiek' && ok "sound panel opens" || bad "sound panel"
ctl menu key esc >/dev/null
ctl menu open keys >/dev/null; ctl menu list | grep -q 'Super+Return' && ok "shortcuts panel lists the binds" || bad "shortcuts list"
ctl menu type "mod+shift, F9, spawn true" >/dev/null; ctl menu list | grep -q 'Dodaj skrot' && ok "a typed shortcut is offered" || bad "bind offer"
ctl menu key enter >/dev/null
grep -q '^bind = mod+shift, F9, spawn true' "$log/cfg/config" && ok "shortcut is written to the config" || bad "bind persist"
ctl menu type F9 >/dev/null; ctl menu list | grep -q 'Super+Shift+F9' && ok "the new shortcut is live and listed" || bad "bind live"
ctl menu key enter >/dev/null
! grep -q 'F9' "$log/cfg/config" && ok "removing a shortcut drops its line" || bad "bind remove"
ctl menu type "mod, Return" >/dev/null; ctl menu key esc >/dev/null
ctl menu open keys >/dev/null; ctl menu type "mod+shift, Return, spawn x" >/dev/null; ctl menu key enter >/dev/null; ctl menu type Super+Shift+Return >/dev/null; ctl menu key enter >/dev/null
grep -q '^unbind = super+shift, Return' "$log/cfg/config" && ok "removing a default shortcut writes an unbind" || bad "unbind"
ctl menu key esc >/dev/null
mkdir -p "$log/cfg/autostart"; printf '#!/bin/sh\ntrue\n' > "$log/cfg/autostart/e2e"; chmod +x "$log/cfg/autostart/e2e"
ctl menu open autostart >/dev/null; ctl menu list | grep -q '\[x\] e2e' && ok "autostart lists an executable as on" || bad "autostart list"
ctl menu key space >/dev/null; [ ! -x "$log/cfg/autostart/e2e" ] && ok "space turns an autostart file off" || bad "autostart toggle"
ctl menu key esc >/dev/null
out=$(ctl menu open bluetooth 2>&1; ctl menu list 2>&1); echo "$out" | grep -qE "Blueman|Urzadzenia" && ok "bluetooth panel lists blueman or says it is missing" || { echo "$out" >&2; bad "bluetooth panel"; }
ctl menu key esc >/dev/null
# wallpaper api: show, set, per output, mode, clear, and refusals that change nothing
ctl wallpaper | grep -q '^\* none (fill)' && ok "wallpaper starts empty" || bad "wallpaper show"
ctl wallpaper bogus | grep -q '^error: unknown wallpaper command' && ok "wallpaper rejects an unknown word" || bad "wallpaper bogus"
ctl wallpaper set pic.png | grep -q 'relative' && ok "wallpaper refuses a relative path" || bad "wallpaper relative"
ctl wallpaper set /nope.png | grep -q 'not a file' && ok "wallpaper refuses a missing file" || bad "wallpaper missing"
printf 'x' > "$log/wp.png"
ctl wallpaper set "$log/wp.png" | grep -q '^ok' && ctl wallpaper | grep -q "^\* $log/wp.png (fill)" && grep -q "^wallpaper = $log/wp.png" "$log/cfg/config" && ok "wallpaper set is shown and saved" || bad "wallpaper set"
ctl wallpaper mode tile | grep -q '^ok' && ctl wallpaper | grep -q '(tile)' && ok "wallpaper mode changes" || bad "wallpaper mode"
ctl wallpaper set -o NOPE "$log/wp.png" | grep -q 'no output' && ok "wallpaper per-output needs a real output" || bad "wallpaper output"
ctl wallpaper set -o winit "$log/wp.png" | grep -q '^ok' && ctl wallpaper | grep -q "^winit $log/wp.png" && ok "wallpaper per output" || bad "wallpaper per output"
ctl wallpaper clear winit >/dev/null; ctl wallpaper clear >/dev/null; ctl wallpaper | grep -q '^\* none' && ! ctl wallpaper | grep -q '^winit' && ok "wallpaper clear" || bad "wallpaper clear"
# notification center: groups by app, do-not-disturb, snooze, mute, per-app log, the panel
ctl notify send -a discord -t im.received "ping from discord" | grep -q '^ok' && ok "notify send posts under an app" || bad "notify send"
ctl notify send -a files -i 41 -A open=Open+folder,default=Go -- "copy done" | grep -q '^ok' && ctl notify list files | grep -q 'open=Open folder, default=Go' && ok "notify keeps the buttons of a note" || bad "notify actions"
fid=$(ctl notify list files | tail -1 | cut -f1)
ctl notify invoke "$fid" nope | grep -q 'has no action' && ok "notify invoke refuses an unknown action" || bad "invoke unknown"
ctl notify invoke "$fid" open | grep -q '^ok invoked open' && sleep 0.3 && grep -q '^41 open' "$log/invoke.log" && ok "notify invoke tells the sender, with its own id" || bad "invoke"
ctl notify list files | tail -1 | grep -q 'open=' && bad "buttons stay after invoke" || ok "buttons are gone after an invoke"
ctl notify invoke 999999 x | grep -q 'no notification' && ok "notify invoke refuses an unknown note" || bad "invoke missing"
ctl notify apps | grep -qP '^discord\t1\t' && ok "notify apps groups by app" || bad "notify apps"
ctl notify dnd on | grep -q 'dnd on' && ctl notify send -a matrix "quiet one" >/dev/null && ctl notify status | grep -q 'missed 1' && ok "dnd holds a note back and counts it as missed" || bad "dnd"
ctl notify send -a matrix -u critical "fire" >/dev/null; ctl notify list matrix | grep -q 'fire' && ok "a critical note goes through dnd" || bad "critical"
ctl menu open notes >/dev/null; ctl menu list | grep -q 'discord' && ctl menu list | grep -q 'wycisz matrix' && ok "the panel groups notes per app" || bad "notts panel"
ctl notify status | grep -q 'missed 0' && ok "opening the panel marks the missed notes seen" || bad "missed not cleared"
ctl menu key esc >/dev/null
ctl notify dnd off >/dev/null; ctl notify snooze 5 | grep -q 'snooze 5 min' && ctl notify status | grep -q 'snooze [45] min' && ok "snooze" || bad "snooze"
ctl notify snooze off >/dev/null; ctl notify snooze 0x 2>&1 | grep -q '^error' && ok "bad snooze rejected" || bad "bad snooze"
ctl notify mute discord >/dev/null; ctl notify apps | grep -qP '^discord\t1\t.*\tmuted' && ok "mute shows in the groups" || bad "mute"
ctl notify unmute discord >/dev/null
ctl notify log discord | grep -q 'ping from discord' && [ -f "$log/state/finedesktop/notts/log/discord.log" ] && ok "every note lands in the app's log" || bad "notify log"
ctl notify send -u loud x 2>&1 | grep -q '^error' && ok "bad urgency rejected" || bad "bad urgency"
ctl notify clear discord >/dev/null; ctl notify apps | grep -q '^discord' && bad "clear one app" || ok "clear one app"
ctl notify clear >/dev/null; ctl notify | grep -q 'no notifications' && ok "clear all" || bad "clear all"
# hardware panels: they list something or say why not, and never break
for pan in wallpaper devices drivers screens input; do
  ctl menu open $pan >/dev/null; ctl menu list | head -3 | grep -q . && ok "panel $pan opens" || bad "panel $pan"
  ctl menu key esc >/dev/null
done
ctl menu open update >/dev/null; ctl menu list | head -1 | grep -q 'Menu > Ustawienia > System > Aktualizacje$' && ok "update panel sits under System" || bad "update panel"
ctl menu key esc >/dev/null
ctl menu open cleaner >/dev/null; ctl menu list | head -1 | grep -q 'Czyszczenie' && ok "cleaner panel opens" || bad "cleaner panel"
ctl menu key esc >/dev/null
ctl menu open input >/dev/null; ctl menu list | grep -q 'Przyspieszenie: \[adaptacyjne v\]' && ok "input panel has the acceleration dropdown" || bad "input accel"
ctl menu type Przyspieszenie >/dev/null; ctl menu key enter >/dev/null; ctl menu list | grep -q 'plaskie' && ok "a dropdown opens its options" || bad "dropdown options"
ctl menu key down >/dev/null; ctl menu key enter >/dev/null
grep -q '^accel_profile = flat' "$log/cfg/config" && ok "a dropdown choice is written to the config" || bad "dropdown persist"
ctl menu key esc >/dev/null
ctl menu open prefer >/dev/null; ctl menu list | grep -q 'shell: ' && ok "preferred apps has the shell role" || bad "shell role"
