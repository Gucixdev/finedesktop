# the launcher opens on the root list; typing searches everything, erasing it all comes back
ctl menu launch >/dev/null; ctl menu list | grep -q 'Glosnik' && ok "launcher shows the sound sliders on top" || bad "launcher sound rows"
ctl menu list | grep -n '^> ' | grep -q 'Aplikacje' && ok "launcher cursor starts on Aplikacje, not the sliders" || bad "launcher cursor"
