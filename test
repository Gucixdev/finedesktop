#!/usr/bin/env bash
# End-to-end test: nested compositor + real foot clients, driven through the control socket.
# Needs a running host Wayland session. Usage: ./test   (runs `cargo test` first)
set -u
cd "$(dirname "$0")"
cargo test -q 2>&1 | tail -3 || exit 1
cargo build -q 2>&1 | grep -E '^error' && exit 1
cargo build -q --release -p finedesktop-engine 2>&1 | grep -E '^error' && exit 1

bin=$PWD/target/debug/finedesktop
log=$(mktemp -d)
fail=0
ok()  { echo "ok   $1"; }
bad() { echo "FAIL $1"; fail=1; }

# own config dir: never the user's autostart, and the real pointer must not move focus
mkdir -p "$log/cfg"; cp target/release/libfinedesktop_engine.so "$log/engine.so"
printf 'focus_follows_mouse = off\nengine = %s\n' "$log/engine.so" > "$log/cfg/config"
touch "$log/start"; sleep 0.05
FD_BACKEND=winit FD_CONFIG_DIR="$log/cfg" "$bin" >"$log/c.log" 2>&1 &
cpid=$!
trap 'kill $cpid 2>/dev/null; wait $cpid 2>/dev/null' EXIT

for _ in $(seq 50); do
  sock=$(find "${XDG_RUNTIME_DIR:-/tmp}" -maxdepth 1 -name 'finedesktop-*.sock' -newer "$log/start" 2>/dev/null | head -1)
  [ -n "${sock:-}" ] && [ -S "$sock" ] && break
  sleep 0.1
done
export FD_SOCK=$sock
ctl() { "$bin" ctl "$@"; }
wait_clients() { # want_count
  for _ in $(seq 60); do
    n=$(ctl state | grep -c '^  ws')
    [ "$n" = "$1" ] && return 0
    sleep 0.1
  done
  return 1
}
geo() { ctl state | grep "^  ws$1 #$2" | grep -o '[0-9]*x[0-9]*@[0-9-]*,[0-9-]*\|hidden'; }

# --- themes, modes, events ---
[ "$(ctl theme list | grep -c 'matrix\*')" = 1 ] && ok "theme list marks the active one" || bad "theme list"
[ "$(ctl theme dracula)" = ok ] && ctl theme list | grep -q 'dracula\*' && ok "theme switch" || bad "theme switch"
[ "$(ctl theme nope | cut -c1-6)" = error: ] && ok "unknown theme rejected" || bad "unknown theme accepted"
[ "$(ctl mode gamemode)" = ok ] && ok "mode on" || bad "mode on"
ctl theme list | grep -q 'dracula\*' && ok "mode leaves the theme alone" || bad "mode changed the theme"
[ "$(ctl mode off)" = ok ] && ok "mode off" || bad "mode off"
[ "$(ctl mode nightmode)" = ok ] && ctl theme list | grep -q 'zen\*' && ok "nightmode switches theme" || bad "nightmode"
ctl mode off >/dev/null; ctl theme list | grep -q 'dracula\*' && ok "mode off restores theme" || bad "theme not restored"
ctl theme matrix >/dev/null
[ "$(ctl welcome show)" = ok ] && [ "$(ctl welcome hide)" = ok ] && [ "$(ctl welcome auto)" = ok ] && ok "welcome show/hide/auto" || bad "panel actions"
[ "$(ctl welcome bogus | cut -c1-6)" = error: ] && ok "bad welcome action rejected" || bad "bad welcome action accepted"
( ctl subscribe > "$log/sub.out" 2>&1 & echo $! > "$log/sub.pid" ); sleep 0.3
ctl emit ping hello >/dev/null; ctl bar toggle >/dev/null; ctl bar toggle >/dev/null; sleep 0.3
kill "$(cat "$log/sub.pid")" 2>/dev/null
grep -q '^user ping hello' "$log/sub.out" && ok "subscribe streams user events" || bad "subscribe: $(cat "$log/sub.out")"

[ "$(ctl state | head -1 | grep -c monitor)" = 1 ] && ok "state reports a monitor" || bad "no monitor"
out=$(ctl state | head -1); W=$(echo "$out" | sed -E 's/.* ([0-9]+)x[0-9]+@.*/\1/')

for i in 1 2 3; do ctl spawn foot -e sleep 60 >/dev/null; sleep 0.4; done
wait_clients 3 && ok "3 clients mapped" || bad "clients did not map"
foc() { ctl state | grep -o '^  ws[0-9]* #[0-9]*\*' | grep -o '#[0-9]*'; }
ctl layout tile >/dev/null; ctl view 1 >/dev/null; sleep 0.3
[ "$(foc)" = "#0" ] || ctl focus left >/dev/null
ctl focus right >/dev/null; sleep 0.2; [ "$(foc)" = "#1" ] && ok "focus right: master -> stack" || bad "focus right: $(foc)"
ctl focus down >/dev/null; sleep 0.2;  [ "$(foc)" = "#2" ] && ok "focus down inside the stack" || bad "focus down: $(foc)"
ctl focus up >/dev/null; sleep 0.2;    [ "$(foc)" = "#1" ] && ok "focus up inside the stack" || bad "focus up: $(foc)"
ctl focus left >/dev/null; sleep 0.2;  [ "$(foc)" = "#0" ] && ok "focus left: back to master" || bad "focus left: $(foc)"
ctl focus up >/dev/null; sleep 0.2;    [ "$(foc)" = "#0" ] && ok "focus up at the edge stays" || bad "focus up edge: $(foc)"
ctl focus right >/dev/null; sleep 0.2; ctl focus last >/dev/null; sleep 0.2; [ "$(foc)" = "#0" ] && ok "focus last returns to the previous window" || bad "focus last: $(foc)"
ctl move right >/dev/null; sleep 0.3;  [ "$(foc)" = "#1" ] && ok "move right swaps with the stack window" || bad "move right: $(foc)"
ctl move left >/dev/null; sleep 0.3;   [ "$(foc)" = "#0" ] && ok "move left swaps back" || bad "move left: $(foc)"

ctl layout tile >/dev/null; sleep 0.3
g0=$(geo 1 0); mw=${g0%%x*}
[ "$mw" = "$((W * 55 / 100))" ] && ok "tile: master is 55% ($mw of $W)" || bad "tile master width $mw of $W"

ctl mfact +0.1 >/dev/null; sleep 0.3
g0=$(geo 1 0); mw=${g0%%x*}
[ "$mw" = "$((W * 65 / 100))" ] && ok "mfact +0.1 -> $mw" || bad "mfact gave $mw"

ctl layout monocle >/dev/null; sleep 0.3
hid=$(ctl state | grep -c 'hidden')
[ "$hid" = 2 ] && ok "monocle hides 2 of 3" || bad "monocle hidden=$hid"

ctl layout grid >/dev/null; sleep 0.3
hid=$(ctl state | grep -c 'hidden')
[ "$hid" = 0 ] && ok "grid shows all" || bad "grid hidden=$hid"

ctl layout float >/dev/null; sleep 0.3
ctl state | grep '^  ws' | grep -q hidden && bad "float hides windows" || ok "float shows all"

ctl layout tile >/dev/null
ctl view 2 >/dev/null; sleep 0.3
ctl state | head -1 | grep -q 'ws 2/9' && ok "view 2" || bad "view 2"
[ "$(ctl state | grep -c hidden)" = 3 ] && ok "ws1 clients hidden on ws2" || bad "ws1 clients visible on ws2"
ctl spawn foot -e sleep 60 >/dev/null; wait_clients 4 && ok "client on ws2" || bad "ws2 client"
ctl view 1 >/dev/null; sleep 0.3
ctl state | grep -q '^  ws2 #0.* hidden' && ok "ws2 client hidden on ws1" || bad "ws2 client not hidden"

ctl tag 3 >/dev/null; sleep 0.3
ctl state | grep -q '^  ws3 #0' && ok "tag 3 moved focused window" || bad "tag 3"

ctl focus next >/dev/null; ctl close >/dev/null
for _ in $(seq 30); do [ "$(ctl state | grep -c '^  ws')" = 3 ] && break; sleep 0.1; done
[ "$(ctl state | grep -c '^  ws')" = 3 ] && ok "close removed a client" || bad "close"

# hot reload of the engines: windows stay where they are, a broken library is refused and the old one keeps working
ctl layout tile >/dev/null; sleep 0.3
before=$(ctl state | grep -c '^  ws')
ctl reload-engine 2>&1 | grep -q 'engine loaded' && ok "reload-engine loads the library" || bad "reload-engine"
[ "$(ctl state | grep -c '^  ws')" = "$before" ] && ok "reload-engine keeps the windows" || bad "reload-engine lost windows"
cp "$log/engine.so" "$log/engine.good"; echo junk > "$log/engine.so"
ctl reload-engine 2>&1 | grep -q '^error' && ok "broken engine library refused" || bad "broken engine accepted"
ctl layout grid 2>&1 | grep -q '^ok' && ok "layouts still work after a refused reload" || bad "layout after refused reload"
ctl layout tile >/dev/null; cp "$log/engine.good" "$log/engine.so"

# the menu, driven like an agent would: open, type, select
ctl menu open settings | grep -q '^ok' && ok "menu opens" || bad "menu open"
ctl menu list | head -1 | grep -q '^Menu > Ustawienia$' && ok "menu shows its breadcrumb" || bad "menu breadcrumb"
ctl menu type uklad >/dev/null; ctl menu key enter >/dev/null
ctl menu type mono >/dev/null; ctl menu list | sed -n 2p | grep -q 'monocle' && ok "menu filters" || bad "menu filter"
ctl menu key enter >/dev/null; sleep 0.3
ctl state | head -1 | grep -q 'layout monocle' && ok "menu entry changes the layout" || bad "menu layout entry"
ctl menu list 2>&1 | grep -q 'not open' && ok "menu closes after a choice" || bad "menu stayed open"
ctl layout tile >/dev/null
ctl menu open apps >/dev/null; ctl menu key backspace >/dev/null; ctl menu list | head -1 | grep -q '^Menu$' && ok "backspace leaves a level" || bad "backspace level"
ctl menu key esc >/dev/null; ctl menu list 2>&1 | grep -q 'not open' && ok "esc closes the menu" || bad "esc"
ctl menu open nonsense 2>&1 | grep -q '^error' && ok "bad menu id rejected" || bad "bad menu id"

# calculator and preferred applications through the menu / ctl
ctl menu open calc >/dev/null; ctl menu type "2+3*4" >/dev/null
ctl menu list | sed -n 2p | grep -q '= 14' && ok "menu calculator" || bad "menu calculator"
ctl menu key esc >/dev/null
ctl prefer | grep -q '^terminal = ' && ok "ctl prefer lists roles" || bad "ctl prefer list"
ctl prefer nonsense 2>&1 | grep -q '^error' && ok "unknown role rejected" || bad "unknown role"
ctl menu open prefer >/dev/null; ctl menu list | sed -n 2p | grep -q 'terminal:' && ok "menu lists the roles" || bad "menu prefer"
ctl menu key esc >/dev/null

ctl bogus >/dev/null 2>&1 && bad "bogus action accepted" || ok "bogus action rejected"
ctl layout nope 2>&1 | grep -q '^error' && ok "bad layout rejected" || bad "bad layout accepted"

ctl quit >/dev/null; sleep 0.5
kill -0 $cpid 2>/dev/null && bad "quit did not stop" || ok "quit stops the compositor"
trap - EXIT
[ $fail = 0 ] && echo "ALL OK" || { echo "FAILED (logs: $log)"; exit 1; }
